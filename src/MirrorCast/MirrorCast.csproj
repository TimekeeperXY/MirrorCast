<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MirrorCast</AssemblyName>
    <RootNamespace>MirrorCast</RootNamespace>
    <Platforms>x64</Platforms>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Product>MirrorCast</Product>
    <Company>晓阳的百宝箱</Company>
    <Description>把主屏指定窗口实时镜像到副屏全屏显示</Description>
    <Copyright>Copyright (c) 2026 晓阳的百宝箱</Copyright>
  </PropertyGroup>

  <!--
    Single-file publish settings.
    IncludeNativeLibrariesForSelfExtract is REQUIRED: WPF's native dependencies
    (wpfgfx_cor3.dll, PresentationNative_cor3.dll, vcruntime140_cor3.dll, ...) are
    left beside the exe without it, so a lone MirrorCast.exe would fail to start
    on the user's machine.
  -->
  <PropertyGroup>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
