<Window x:Class="MirrorCast.MirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MirrorCast"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid>
        <TextBlock x:Name="OverlayText"
                   Text="源窗口已最小化"
                   Foreground="#666666"
                   FontSize="28"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
<!--
            NOTE: nothing drawn here can appear above the mirrored picture — DWM
            composites the thumbnail on top of this window's own content. Any overlay
            (cursor, badges, watermarks) must live in a separate top-level window.
            See CursorOverlayWindow.
        -->
    </Grid>
</Window>
