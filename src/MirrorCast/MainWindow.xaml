<Window x:Class="MirrorCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MirrorCast"
        xmlns:models="clr-namespace:MirrorCast.Models"
        mc:Ignorable="d"
        Title="MirrorCast · 窗口镜像 — created by @晓阳的百宝箱" Height="812" Width="440"
        MinHeight="500" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{DynamicResource AppTextPrimaryBrush}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:ScaleModeToLabelConverter x:Key="ScaleModeToLabel"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">

        <!-- Idle / selection panel -->
        <ScrollViewer Visibility="{Binding IsMirroring, Converter={StaticResource InverseBoolToVis}}"
                      Background="Transparent"
                      VerticalScrollBarVisibility="Auto" Padding="18">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="MirrorCast" FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="窗口镜像" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" Padding="0,0,0,3"/>
            </StackPanel>
            <TextBlock Text="created by @晓阳的百宝箱" FontSize="11"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,16" Opacity="0.85"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索窗口标题或进程名"/>
                <Button Grid.Column="1" Content="刷新" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

            <Border x:Name="WindowListCard" Style="{StaticResource CardBorderStyle}" Height="210" Margin="0,0,0,14">
                <ListBox ItemsSource="{Binding WindowsView}" SelectedItem="{Binding SelectedWindow}"
                         IsSynchronizedWithCurrentItem="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:WindowInfo}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProcessName, StringFormat=' ({0})'}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Expander Header="安卓设备投屏" Margin="0,0,0,14">
                <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,6,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding AndroidDevices}"
                                      SelectedItem="{Binding SelectedAndroidDevice}"
                                      DisplayMemberPath="DisplayName"
                                      ToolTip="已通过 USB 或无线 ADB 授权的设备"/>
                            <Button Grid.Column="1" Content="刷新设备" Margin="8,0,0,0"
                                    Command="{Binding RefreshAndroidCommand}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding AndroidAddress, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="可选：无线调试 IP 或主机名；留空则使用上方设备"
                                     Padding="8,5"/>
                            <TextBox Grid.Column="1" Text="{Binding AndroidPort, UpdateSourceTrigger=LostFocus}"
                                     Margin="8,0,0,0" ToolTip="无线 ADB 连接端口" Padding="8,5"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="帧率上限" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AndroidFrameRates}"
                                      SelectedItem="{Binding AndroidMaxFps}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="允许控制" IsChecked="{Binding AndroidControl}" Margin="8,0"/>
                                <CheckBox Content="电脑播放声音" IsChecked="{Binding AndroidAudio}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="投屏后关闭手机显示屏" IsChecked="{Binding AndroidTurnScreenOff}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding AndroidStatus}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Button Content="{Binding AndroidActionText}" Height="36"
                                Command="{Binding StartAndroidCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Border>
            </Expander>

            <TextBlock Text="目标显示器" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,6"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <Border x:Name="MonitorListCard" Style="{StaticResource CardBorderStyle}" Height="68" Margin="0,0,0,6">
                <ListBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"
                         IsSynchronizedWithCurrentItem="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:MonitorInfo}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Resolution}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Text="仅检测到一个显示器，请连接副屏后重试" Foreground="{DynamicResource AppDangerBrush}" Margin="2,0,0,10"
                       FontSize="12" TextWrapping="Wrap"
                       Visibility="{Binding CanStart, Converter={StaticResource InverseBoolToVis}}"/>

            <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,4,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="显示模式" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ScaleModes}" SelectedItem="{Binding ScaleMode}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ScaleModeToLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <CheckBox Content="只显示窗口内容（不含标题栏）" IsChecked="{Binding ClientAreaOnly}" Margin="0,5"/>
                    <CheckBox Content="在副屏显示鼠标指针" IsChecked="{Binding ShowSyntheticCursor}" Margin="0,5"
                              ToolTip="镜像画面本身不含指针，勾选后会把你的指针位置叠加显示出来"/>
                    <CheckBox Content="副屏隐藏真实光标" IsChecked="{Binding HideCursor}" Margin="0,5"
                              ToolTip="当你把鼠标移到副屏上时，隐藏真实的鼠标光标"/>
                    <CheckBox Content="开机自启动" IsChecked="{Binding StartWithWindows}" Margin="0,5,0,0"/>

                    <Border Height="1" Background="{DynamicResource AppCardBorderBrush}" Margin="0,12,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="快捷键" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="HotkeyButton" Grid.Column="1" Height="32"
                                Content="{Binding HotkeyDisplay}"
                                Tag="{x:Static models:HotkeyAction.Mirror}"
                                Click="HotkeyButton_Click"
                                ToolTip="点击后按下新的组合键，需包含 Ctrl / Alt / Shift 之一；按 Esc 取消"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="演示辅助" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,6"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="镜像时启用 F1-F4 演示快捷模式"
                              IsChecked="{Binding PresentationKeyModeEnabled}"
                              Margin="0,0,0,14"
                              ToolTip="F1 屏幕放大、F2 指针放大镜、F3 指针聚光灯、F4 屏幕标注；Esc 退出当前功能"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="放大倍数" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Grid.Column="1" Minimum="1.25" Maximum="5" TickFrequency="0.25"
                                IsSnapToTickEnabled="True" Value="{Binding PresentationZoomFactor}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PresentationZoomFactor, StringFormat={}{0:0.00}x}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="指针范围" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Grid.Column="1" Minimum="120" Maximum="480" TickFrequency="20"
                                IsSnapToTickEnabled="True" Value="{Binding PointerEffectSize}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PointerEffectSize, StringFormat={}{0:0} px}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="屏幕放大" VerticalAlignment="Center" Margin="0,0,12,8"/>
                        <Button Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,8"
                                Content="{Binding ScreenZoomHotkeyDisplay}"
                                Tag="{x:Static models:HotkeyAction.ScreenZoom}"
                                Click="HotkeyButton_Click"/>
                        <TextBlock Grid.Row="1" Text="指针放大镜" VerticalAlignment="Center" Margin="0,0,12,8"/>
                        <Button Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,8"
                                Content="{Binding MagnifierHotkeyDisplay}"
                                Tag="{x:Static models:HotkeyAction.Magnifier}"
                                Click="HotkeyButton_Click"/>
                        <TextBlock Grid.Row="2" Text="指针聚光灯" VerticalAlignment="Center" Margin="0,0,12,8"/>
                        <Button Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,0,8"
                                Content="{Binding SpotlightHotkeyDisplay}"
                                Tag="{x:Static models:HotkeyAction.Spotlight}"
                                Click="HotkeyButton_Click"/>
                        <TextBlock Grid.Row="3" Text="屏幕标注" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Grid.Row="3" Grid.Column="1" Height="30"
                                Content="{Binding AnnotationHotkeyDisplay}"
                                Tag="{x:Static models:HotkeyAction.Annotation}"
                                Click="HotkeyButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="StartButton" Content="{Binding StartButtonText}" Height="42"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding StartCommand}"/>
        </StackPanel>
        </ScrollViewer>

        <!-- Mirroring status panel -->
        <StackPanel Visibility="{Binding ShowMirroringStatus, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center" Margin="24">
            <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                <StackPanel>
                    <TextBlock Text="🎯 正在镜像" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding SelectedWindow.DisplayTitle}" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="↓" FontSize="18" HorizontalAlignment="Center" Margin="0,6"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                        <TextBlock Text="{Binding SelectedMonitor.DisplayName}"/>
                        <TextBlock Text=" ("/>
                        <TextBlock Text="{Binding SelectedMonitor.Resolution}"/>
                        <TextBlock Text=")"/>
                    </StackPanel>

                    <Button Content="{Binding StopButtonText}" Height="42" Margin="0,0,0,10"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StopCommand}"/>
                    <Button Content="更换镜像窗口" Height="34"
                            Command="{Binding OpenSwitchWindowCommand}" Margin="0,0,0,18"/>

                    <TextBlock Text="演示辅助" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Button Content="{Binding ScreenZoomButtonText}" Height="34" Margin="0,0,0,8"
                            Command="{Binding ToggleScreenZoomCommand}"/>
                    <Button Content="{Binding MagnifierButtonText}" Height="34" Margin="0,0,0,8"
                            Command="{Binding ToggleMagnifierCommand}"/>
                    <Button Content="{Binding SpotlightButtonText}" Height="34" Margin="0,0,0,8"
                            Command="{Binding ToggleSpotlightCommand}"/>
                    <Button Content="{Binding AnnotationButtonText}" Height="34"
                            Command="{Binding ToggleAnnotationCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Quick window-switch panel (mirroring stays live while picking) -->
        <DockPanel Visibility="{Binding ShowSwitchPanel, Converter={StaticResource BoolToVis}}"
                   Margin="18">
            <TextBlock DockPanel.Dock="Top" Text="选择要切换到的窗口" FontSize="16" FontWeight="Bold" Margin="2,0,0,12"/>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索窗口标题或进程名"/>
                <Button Grid.Column="1" Content="刷新" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

            <Button DockPanel.Dock="Bottom" Content="取消" Height="34" Margin="0,10,0,0"
                    Command="{Binding CancelSwitchWindowCommand}"/>

            <Border Style="{StaticResource CardBorderStyle}">
                <ListBox x:Name="SwitchListBox" ItemsSource="{Binding SwitchWindowsView}"
                         IsSynchronizedWithCurrentItem="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="SwitchListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:WindowInfo}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProcessName, StringFormat=' ({0})'}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- First-run walkthrough. Sits above everything; shown once, then never again. -->
        <Grid x:Name="OnboardingOverlay" Visibility="Collapsed" Panel.ZIndex="100">
            <!-- Keep the walkthrough modal while the dimmer leaves a clear spotlight over the target. -->
            <Rectangle Fill="Transparent"/>
            <Path x:Name="OnboardingDimmer" Fill="#B0000000" IsHitTestVisible="False"/>

            <!-- Ring drawn over whichever control the current step is talking about -->
            <Border x:Name="OnboardingHighlight"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2.5"
                    CornerRadius="12" Background="#18FFFFFF" IsHitTestVisible="False">
                <Border.Effect>
                    <BlurEffect Radius="0"/>
                </Border.Effect>
            </Border>

            <Border x:Name="OnboardingCard"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource AppFlyoutBackgroundBrush}"
                    BorderBrush="{DynamicResource AppFlyoutBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18,16" MaxWidth="330">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="OnboardingStepLabel" Text="第 1 / 4 步" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="OnboardingTitle" Text="" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,8"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="OnboardingBody" Text="" FontSize="13"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" Opacity="0.85"
                               TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20"/>
                    <Grid>
                        <Button Content="跳过" HorizontalAlignment="Left" Padding="14,6"
                                Click="OnboardingSkip_Click"/>
                        <Button x:Name="OnboardingNext" Content="下一步" HorizontalAlignment="Right"
                                Padding="18,6" Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnboardingNext_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
