<Window x:Class="MirrorCast.AnnotationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:annotations="clr-namespace:MirrorCast.Annotations"
        Title="MirrorCastAnnotationOverlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="800" Height="500"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <annotations:AnnotationCanvas x:Name="DrawingSurface" IsEditing="True"/>

        <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="10" Padding="6"
                Background="#F0222227" BorderBrush="#4DFFFFFF" BorderThickness="1"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="2" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PenButton" Content="笔" Tag="{x:Static annotations:AnnotationTool.Pen}"
                        Width="30" Height="30" Padding="0" Foreground="White" ToolTip="画笔" Click="Tool_Click"/>
                <Button x:Name="HighlighterButton" Content="荧" Tag="{x:Static annotations:AnnotationTool.Highlighter}"
                        Width="30" Height="30" Padding="0" Foreground="White" ToolTip="荧光笔" Click="Tool_Click"/>
                <Button x:Name="LineButton" Content="╱" Tag="{x:Static annotations:AnnotationTool.Line}"
                        Width="30" Height="30" Padding="0" Foreground="White" ToolTip="直线" Click="Tool_Click"/>
                <Button x:Name="ArrowButton" Content="→" Tag="{x:Static annotations:AnnotationTool.Arrow}"
                        Width="30" Height="30" Padding="0" Foreground="White" ToolTip="箭头" Click="Tool_Click"/>
                <Button x:Name="RectangleButton" Content="□" Tag="{x:Static annotations:AnnotationTool.Rectangle}"
                        Width="30" Height="30" Padding="0" Foreground="White" ToolTip="矩形" Click="Tool_Click"/>
                <Button x:Name="EllipseButton" Content="○" Tag="{x:Static annotations:AnnotationTool.Ellipse}"
                        Width="30" Height="30" Padding="0" Foreground="White" ToolTip="椭圆" Click="Tool_Click"/>
                <Button x:Name="EraserButton" Content="擦" Tag="{x:Static annotations:AnnotationTool.Eraser}"
                        Width="30" Height="30" Padding="0" Foreground="White" ToolTip="橡皮擦" Click="Tool_Click"/>

                <Border Width="1" Background="#40FFFFFF" Margin="6,4"/>

                <Button Width="24" Height="24" Padding="0" Margin="2,3" Background="#FFFF3B30"
                        Tag="#FFFF3B30" ToolTip="红色" Click="Color_Click"/>
                <Button Width="24" Height="24" Padding="0" Margin="2,3" Background="#FFFFCC00"
                        Tag="#FFFFCC00" ToolTip="黄色" Click="Color_Click"/>
                <Button Width="24" Height="24" Padding="0" Margin="2,3" Background="#FF0A84FF"
                        Tag="#FF0A84FF" ToolTip="蓝色" Click="Color_Click"/>
                <Button Width="24" Height="24" Padding="0" Margin="2,3" Background="#FF32D74B"
                        Tag="#FF32D74B" ToolTip="绿色" Click="Color_Click"/>
                <Button Width="24" Height="24" Padding="0" Margin="2,3" Background="#FFFFFFFF"
                        Tag="#FFFFFFFF" ToolTip="白色" Click="Color_Click"/>

                <Slider x:Name="ThicknessSlider" Width="66" Minimum="2" Maximum="12" Value="4"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0"
                        ToolTip="线条粗细" ValueChanged="ThicknessSlider_ValueChanged"/>

                <Border Width="1" Background="#40FFFFFF" Margin="2,4,6,4"/>

                <Button x:Name="UndoButton" Content="↶" Width="30" Height="30" Padding="0"
                        Foreground="White" ToolTip="撤销 (Ctrl+Z)" Click="Undo_Click"/>
                <Button x:Name="RedoButton" Content="↷" Width="30" Height="30" Padding="0"
                        Foreground="White" ToolTip="重做 (Ctrl+Y)" Click="Redo_Click"/>
                <Button Content="清" Width="30" Height="30" Padding="0"
                        Foreground="White" ToolTip="清除全部标注" Click="Clear_Click"/>
                <Button Content="×" Width="30" Height="30" Padding="0" Margin="4,0,0,0"
                        Foreground="White" Background="#44FF453A" ToolTip="退出标注 (Esc)" Click="Exit_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
